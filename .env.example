# QueryTrellis Environment Configuration
# Copy this file to .env and adjust values for your local PostgreSQL instance.
# Never commit .env to version control.

# Target PostgreSQL Connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=querytrellis_sample
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=prefer
PGCONNECT_TIMEOUT=5

# Safe Execution Guardrails
QT_DEFAULT_STATEMENT_TIMEOUT_MS=5000
QT_DEFAULT_MAX_ROWS=500
QT_BENCHMARK_MAX_REPEATS=20

# Local SQLite Application Metadata Store (kept separate from analyzed PostgreSQL DB)
QT_METADATA_DB_PATH=data/querytrellis_meta.db

# Streamlit UI Server
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=127.0.0.1

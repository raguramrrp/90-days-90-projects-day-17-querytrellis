# QueryTrellis Environment Configuration
# Copy this file to .env and adjust values if connecting to live engines or custom AI endpoints.
# Never commit .env or live credentials to version control.

# Default Active Dialect (postgresql | mysql | sqlite | sqlserver)
QT_DEFAULT_DIALECT=postgresql

# FastAPI Backend & Next.js Frontend Ports
QT_API_HOST=127.0.0.1
QT_API_PORT=8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional Live PostgreSQL Connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=querytrellis_sample
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=prefer
PGCONNECT_TIMEOUT=5

# Optional Live MySQL Connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# Optional Live Microsoft SQL Server Connection
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=

# Optional SQLite File Path
SQLITE_PATH=

# Safe Execution Guardrails
QT_DEFAULT_STATEMENT_TIMEOUT_MS=5000
QT_DEFAULT_MAX_ROWS=500
QT_BENCHMARK_MAX_REPEATS=20

# Local SQLite Application Metadata Store (kept separate from analyzed databases)
QT_METADATA_DB_PATH=data/querytrellis_meta.db

# SQL Synthesis Engine Configuration (Built-in Deterministic Schema AST Compiler default; zero local agents)
QT_AI_PROVIDER=deterministic

# Optional External AI Adapter (opt-in only; consent must also be granted in Engine & API Settings)
QT_EXTERNAL_AI_PROVIDER=openai
QT_EXTERNAL_AI_BASE_URL=https://api.openai.com/v1
QT_EXTERNAL_AI_MODEL=gpt-4o-mini
QT_EXTERNAL_AI_API_KEY=

# Legacy Streamlit Performance Workbench Port
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=127.0.0.1
